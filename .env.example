# Never put real secrets in Git or browser code.
PUTER_TOKEN=replace_with_new_puter_token
# Client API key required by /v1 endpoints
ACCESS_TOKEN=generate_a_long_random_value
# Protects dashboard analytics at /
DASHBOARD_KEY=generate_another_long_random_value
DEFAULT_MODEL=anthropic/claude-sonnet-5
MODELS=anthropic/claude-sonnet-5,z-ai/glm-4.7,z-ai/glm-4.6,z-ai/glm-4.5
# Set your site origin in production instead of * if calling from a browser
CORS_ORIGIN=*
